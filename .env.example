# Copia este archivo a .env.local (excluido de Git) y completa los valores.
# NUNCA pongas secretos en variables NEXT_PUBLIC_*: esas se envían al navegador.

# --- Sitio ---------------------------------------------------------------
# URL pública (sin barra final). En Vercel: dominio de Preview o Production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" solo cuando el catálogo sea real y se apruebe el lanzamiento.
NEXT_PUBLIC_SITE_INDEXABLE=false

# --- Catálogo y base de datos ----------------------------------------------
# demo = archivos locales de demostración; supabase = PostgreSQL (DATABASE_URL).
CATALOG_SOURCE=demo
# Supabase > Project Settings > Database > Connection string > Transaction pooler (puerto 6543).
DATABASE_URL=

# --- Pedidos ---------------------------------------------------------------
# Cadena aleatoria de al menos 32 caracteres (ej.: openssl rand -base64 48).
ORDER_TOKEN_SECRET=
# Minutos que se reservan las existencias de un pedido sin pagar (15–1440).
ORDER_RESERVATION_MINUTES=120
# Secreto para la tarea programada /api/cron/expirar-pedidos (Vercel Cron).
CRON_SECRET=

# --- Pagos (Wompi) ---------------------------------------------------------
# none = sin pasarela (checkout solo valida). wompi = activa la integración.
PAYMENTS_PROVIDER=none
# sandbox | production. Usa llaves pub_test_/prv_test_ en sandbox.
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=
# Dashboard de Wompi > Desarrolladores > Secretos para integración técnica.
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Solo pruebas locales --------------------------------------------------
# PostgreSQL desechable con superusuario para pruebas de integración. Nunca producción.
TEST_DATABASE_URL=
